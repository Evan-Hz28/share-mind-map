# Docker Compose
COMPOSE_PROJECT_NAME=share-mind-map

# PostgreSQL
POSTGRES_DB=share_mind_map
POSTGRES_USER=mindmap
POSTGRES_PASSWORD=123456
POSTGRES_PORT=15432
DATABASE_URL=postgresql://mindmap:123456@localhost:15432/share_mind_map

# Redis
REDIS_PASSWORD=123456
REDIS_PORT=16379
REDIS_URL=redis://default:123456@localhost:16379

# MinIO
MINIO_ROOT_USER=mindmap
MINIO_ROOT_PASSWORD=123456
MINIO_BUCKET=share-mind-map
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_USE_SSL=false

# Local SMTP capture
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
MAILPIT_MAX_MESSAGES=5000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=share-mind-map@localhost

# Application defaults for the future API service
APP_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
SESSION_SECRET=replace-with-random-hex
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
STORAGE_QUOTA_BYTES=10737418240
TRASH_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90
LOG_LEVEL=debug
