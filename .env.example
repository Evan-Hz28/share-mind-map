# Docker Compose
COMPOSE_PROJECT_NAME=share-mind-map
WEB_PORT=8080
API_PORT=3000
WORKER_PORT=3001

# PostgreSQL
POSTGRES_DB=share_mind_map
POSTGRES_USER=mindmap
POSTGRES_PASSWORD=123456
POSTGRES_PORT=15432
DATABASE_URL=postgresql://mindmap:123456@localhost:15432/share_mind_map
COMPOSE_DATABASE_URL=postgresql://mindmap:123456@postgres:5432/share_mind_map

# Redis
REDIS_PASSWORD=123456
REDIS_PORT=16379
REDIS_URL=redis://default:123456@localhost:16379
COMPOSE_REDIS_URL=redis://default:123456@redis:6379

# MinIO
MINIO_ROOT_USER=mindmap
MINIO_ROOT_PASSWORD=12345678
MINIO_BUCKET=share-mind-map
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
COMPOSE_MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=false

# Local SMTP capture
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
MAILPIT_MAX_MESSAGES=5000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=share-mind-map@localhost
# SMTP_USER=
# SMTP_PASSWORD=

# Local application defaults. Replace every credential before production use.
APP_ENV=development
API_HOST=127.0.0.1
# WEB_ORIGIN is the single allowed CORS origin.
WEB_ORIGIN=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080
# Sessions use this local-only secret. CSRF values are generated per session in memory.
SESSION_SECRET=local-only-replace-with-random-hex-value
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1
STORAGE_QUOTA_BYTES=10737418240
TRASH_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90
LOG_LEVEL=debug
TRUST_PROXY_COUNT=1

# XMind worker
WORKER_HOST=127.0.0.1
XMIND_QUEUE_PREFIX=smm
XMIND_FIXTURE_ROOT=/absolute/path/to/share-mind-map/tests/fixtures/xmind
