{
  "name": "@share-mind-map/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:init": "tsx src/cli/init-admin.ts",
    "admin:recover": "tsx src/cli/recover-admin.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run --exclude test/**/*.integration.test.ts",
    "test:unit": "vitest run --exclude test/**/*.integration.test.ts",
    "test:integration": "vitest run test/*.integration.test.ts --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.6",
    "@share-mind-map/database": "workspace:*",
    "@share-mind-map/document-model": "workspace:*",
    "@share-mind-map/storage": "workspace:*",
    "@share-mind-map/xmind": "workspace:*",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "bullmq": "^6.3.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "nodemailer": "^7.0.6",
    "pg": "^8.23.0",
    "pino": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.2",
    "yargs": "^17.7.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/yargs": "^17.0.35",
    "supertest": "^7.2.2"
  }
}
